<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>GridSpawner.Shared</RootNamespace>
    <AssemblyName>GridSpawner.Shared</AssemblyName>
    <LangVersion>12</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- SEBin64 default -->
  <PropertyGroup>
    <SEBin64 Condition="'$(SEBin64)' == ''">D:\SteamLibrary\steamapps\common\SpaceEngineers\Bin64</SEBin64>
  </PropertyGroup>

  <Target Name="CopyToGamePlugins" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(SEBin64)\Plugins\"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
